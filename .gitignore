# macOS
.DS_Store
.AppleDouble
.LSOverride
# The macOS custom-folder-icon file is literally "Icon" + CR. A bare Icon?
# wildcard matches any 5-character name, and since core.ignorecase is true on
# macOS that silently swallowed assets/icons. Anchor it to the CR.
Icon[\r]
._*
.Spotlight-V100
.Trashes

# Editors
.vscode/
.idea/
*.swp
*~

# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json

# Vercel
.vercel/

# Logs
*.log
npm-debug.log*

# Environment / secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# OS / misc
Thumbs.db

# Design system exports — the contents are ported into css/ and docs/,
# so the archives themselves don't belong in git history (~19 MB each).
*.zip
